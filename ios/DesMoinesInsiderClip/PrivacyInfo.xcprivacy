<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy Manifest for the App Clip (PrivacyInfo.xcprivacy) — IOS-AUDIT-REL-012.

  The App Clip is a separately-reviewed bundle, so it needs its own manifest.
  It browses events anonymously (no sign-in, no PII collected) and uses the
  Supabase SDK, which reads/writes UserDefaults — a required-reason API. This
  declares a strict subset of the main app's manifest.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The Clip browses events anonymously; it collects no user data. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults was declared here on the stated grounds that the
		     Supabase SDK reads and writes it. It does not: supabase-swift contains
		     no UserDefaults reference at all (audited 2026-08-23 against its source,
		     since it ships no privacy manifest of its own and its usage is therefore
		     this app's responsibility). The Clip's own four source files use none
		     either.
		     Removed. scripts/check-privacy-manifest.mjs fails the build the moment
		     the Clip touches UserDefaults, which is the direction that actually gets
		     a submission rejected. (IOS-AUDIT-REL-014) -->
	</array>
</dict>
</plist>
