# Des Moines AI Pulse - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=eyJhbG...

# Postgres connection URI for local scripts only (e.g. npm run db:backup) — NEVER commit, never expose in the browser
# Dashboard → Project Settings → Database → Connection string → URI (direct or session pooler; include ?sslmode=require if needed)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# If the DB password has @ # % etc., either encode them in the URI or set the raw password here (overrides the URI’s password):
# SUPABASE_DB_PASSWORD=your-actual-db-password

# =============================================================================
# SITE CONFIGURATION (Required)
# =============================================================================
# Your production site URL (used for OAuth redirects, SEO, etc.)
VITE_SITE_URL=https://desmoinesinsider.com

# Environment: development, staging, or production
# Controls CORS origins and other environment-specific behavior
ENVIRONMENT=development

# =============================================================================
# STRIPE CONFIGURATION (Required for payments)
# =============================================================================
# Stripe publishable key (safe to expose in browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe secret key (NEVER expose in browser - only used in edge functions)
# Set this in Supabase: supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (for verifying webhook signatures)
# Get this from Stripe Dashboard > Developers > Webhooks
# Set this in Supabase: supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# STRIPE PRICE IDS (Required for subscriptions)
# Create these in Stripe Dashboard > Products
# =============================================================================
# Insider Plan ($4.99/month, $49.99/year)
# STRIPE_PRICE_INSIDER_MONTHLY=price_...
# STRIPE_PRICE_INSIDER_YEARLY=price_...

# VIP Plan ($12.99/month, $129.99/year)
# STRIPE_PRICE_VIP_MONTHLY=price_...
# STRIPE_PRICE_VIP_YEARLY=price_...

# =============================================================================
# GOOGLE APIs (Optional - for enhanced features)
# =============================================================================
# Google OAuth Client ID (for Google Sign-In)
# VITE_GOOGLE_CLIENT_ID=...

# Google PageSpeed Insights API key
# PAGESPEED_INSIGHTS_API_KEY=...

# Google Search Console credentials
# GSC_CLIENT_ID=...
# GSC_CLIENT_SECRET=...

# =============================================================================
# AI/ML SERVICES (Optional - for AI features)
# =============================================================================
# OpenAI API key (for AI content generation)
# OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude AI features)
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# EMAIL SERVICES (Optional - for notifications)
# =============================================================================
# Resend API key (for transactional emails)
# RESEND_API_KEY=re_...

# SendGrid API key (alternative email provider)
# SENDGRID_API_KEY=SG....

# =============================================================================
# ERROR TRACKING (Optional — a platform DSN is baked in)
# =============================================================================
# Sentry error tracking is enabled by default in production: the platform DSN is
# hardcoded in src/lib/sentry.ts (DSNs are public/non-secret). Events only send
# from production builds. Set VITE_SENTRY_DSN to route a preview/staging build to
# a different Sentry project. Leave unset to use the platform default.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Edge functions (Deno) report 5xx errors to the same project via
# supabase/functions/_shared/sentry.ts. Override per-environment with:
# supabase secrets set SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# Google Analytics 4 Measurement ID
# VITE_GA_MEASUREMENT_ID=G-...

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable specific features
# VITE_ENABLE_AI_FEATURES=true
# VITE_ENABLE_PAYMENTS=true
# VITE_ENABLE_ANALYTICS=true

# =============================================================================
# SCRIPTS / CLI ONLY (server-side; never bundled into the browser build)
# Read via process.env / Deno.env by scripts/ (db backup, sitemap generation,
# prerender, tests). These are the non-VITE_ names.
# =============================================================================
# Plain (non-VITE) Supabase vars for sitemap + prerender scripts
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbG...
# Service-role key for admin scripts (FULL ACCESS — never expose in the browser).
# Some scripts read SUPABASE_SERVICE_ROLE_KEY, others SUPABASE_SERVICE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
# SUPABASE_SERVICE_KEY=eyJhbG...
# Direct Postgres connection for db backup/restore
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres
# BACKUP_DIR=./backups
# USE_PG_DUMP=true
# Plain SITE_URL for scripts that don't read VITE_SITE_URL
# SITE_URL=https://desmoinesinsider.com
# Playwright E2E base URL (defaults to http://localhost:8082)
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:8082

# =============================================================================
# NOTES FOR EDGE FUNCTIONS
# =============================================================================
# For Supabase Edge Functions, secrets must be set via CLI:
#
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...        # also read as CLAUDE_API / CLAUDE_API_KEY in some functions
# supabase secrets set RESEND_API_KEY=re_...
# supabase secrets set GOOGLE_PLACES_API=...               # geocoding / places backfills
#
# Security / automation controls (added in the WEB-SEC cluster):
# supabase secrets set EDGE_FUNCTION_API_KEY=...             # shared key for admin/cron-triggered functions (_shared/apiKeyAuth.ts)
# supabase secrets set CRAWLER_DOMAIN_ALLOWLIST=a.com,b.com  # extra hosts ai-crawler/analyze-competitor may fetch
# supabase secrets set CRAWLER_ALLOW_ALL=false              # true ONLY for a one-off admin crawl of a new source
# supabase secrets set CORS_PREVIEW_ORIGINS=https://x.lovable.dev  # explicit non-prod preview origins (_shared/cors.ts)
# supabase secrets set ALLOW_LOVABLE_PREVIEWS=true          # false to disable *.lovable.dev previews entirely
#
# To list current secrets:
# supabase secrets list
#
# These secrets are NOT stored in .env and are only accessible in edge functions.
