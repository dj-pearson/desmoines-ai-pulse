#!/usr/bin/env bash
#
# Pre-commit guard (WEB-SEC-008): block committing local env files and obvious
# secrets. Activated via `core.hooksPath` by the npm `prepare` script.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1) Never allow real env files to be committed (.env.example is fine).
blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.local$|\..*\.local$|\.[^/]*$)' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "❌ Refusing to commit environment files (they may contain secrets):"
  printf '   %s\n' $blocked
  echo "   Remove them from the commit (git restore --staged <file>) or use .env.example for placeholders."
  exit 1
fi

# 1b) (IOS-AUDIT-SEC-007) Never commit iOS Secrets files — they bundle the
#     Supabase anon key and are generated at build time from Secrets.xcconfig.
secret_files=$(printf '%s\n' "$staged" | grep -E '(^|/)Secrets\.(xcconfig|generated\.swift)$' || true)
if [ -n "$secret_files" ]; then
  echo "❌ Refusing to commit iOS Secrets files (they bundle the Supabase anon key):"
  printf '   %s\n' $secret_files
  echo "   These are generated at build time — never commit them (see ios/SECRETS.md)."
  exit 1
fi

# 1c) (IOS-AUDIT-SEC-007) Block JWT/anon-key-shaped strings in staged additions.
#     Matches a base64url JWT header.payload.signature (covers Supabase anon and
#     service-role keys). .env.example placeholders use <...> and won't match.
jwt_hits=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' \
  | grep -E 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' || true)
if [ -n "$jwt_hits" ]; then
  echo "❌ Refusing to commit: a JWT/anon-key-shaped string was found in staged changes."
  echo "   Supabase keys are injected at build time and must never be committed."
  exit 1
fi

# 2) If gitleaks is installed locally, run it on the staged changes as a fast
#    second line of defense. Skipped silently when gitleaks isn't present (CI
#    still runs the authoritative scan).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --config .gitleaks.toml >/dev/null 2>&1; then
    echo "❌ gitleaks detected a potential secret in your staged changes."
    echo "   Run: gitleaks protect --staged --verbose --config .gitleaks.toml"
    exit 1
  fi
fi

exit 0
