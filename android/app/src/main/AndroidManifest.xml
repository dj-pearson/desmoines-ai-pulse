<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location: powers "My Location" on the Map tab and nearby search -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Required on API 33+ for BOTH push notifications and event reminders.
        Without this declaration checkSelfPermission(POST_NOTIFICATIONS) can
        never return GRANTED, so PushNotificationService.showNotification and
        NotificationReceiver.onReceive both bail out and the app posts nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms event reminder alarms after a restart; AlarmManager drops them on boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        HapticHelper calls Vibrator.vibrate() with no try/catch and no
        permission check, which is a SecurityException the moment anything
        calls it. It has no callers today (AND-AUDIT-017), so this is a
        landmine rather than a live crash - declared now so wiring up the
        first caller does not ship one. VIBRATE is install-time, so
        declaring it grants it; there is no runtime prompt and no Play
        policy review. Found by lint (AND-AUDIT-013).
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Package visibility (API 30+). Without these queries, resolveActivity()
        returns null for Google Maps / dialer / browser targets even when the
        app is installed, so "Directions", "Call" and "Website" silently
        no-op or always take the fallback path.
    -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:name=".DesMoinesInsiderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DesMoinesInsider">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DesMoinesInsider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Supabase Auth PKCE callback deep link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.desmoines.aipulse"
                    android:host="auth-callback" />
            </intent-filter>

            <!--
                App Shortcut / Assistant deep links (ANDP-015). Parsed by
                ShortcutDispatcher; lets the static shortcuts (and Assistant App
                Actions / adb) open Ask Pulse, restaurant search, or event search
                pre-filled via query params (cuisine, area, openNow, category,
                datePreset).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.desmoines.aipulse" android:host="ask-pulse" />
                <data android:host="find-restaurants" />
                <data android:host="find-events" />
            </intent-filter>

            <!--
                Content and tab deep links parsed by DeepLinkHandler
                (parseCustomScheme). Every host it accepts must be declared
                here or the link never reaches the app — the parser was
                complete but unreachable from outside the process.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.desmoines.aipulse" android:host="event" />
                <data android:host="restaurant" />
                <data android:host="attraction" />
                <data android:host="hotel" />
                <data android:host="home" />
                <data android:host="dining" />
                <data android:host="search" />
                <data android:host="map" />
                <data android:host="favorites" />
                <data android:host="profile" />
            </intent-filter>

            <!--
                Android App Links for desmoinesinsider.com. DeepLinkHandler
                already parses /events/:id, /restaurants/:id, /attractions/:id
                and /hotels/:id, so without this filter every shared link
                bounces to the browser instead of opening the app.

                autoVerify requires public/.well-known/assetlinks.json to carry
                the release signing certificate SHA-256. It currently ships a
                literal "SHA256_FINGERPRINT_HERE" placeholder — verification
                will fail (links still work via the disambiguation dialog)
                until that is replaced with the Play App Signing fingerprint.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="desmoinesinsider.com" />
                <data android:host="www.desmoinesinsider.com" />
                <data android:pathPrefix="/events" />
                <data android:pathPrefix="/restaurants" />
                <data android:pathPrefix="/attractions" />
                <data android:pathPrefix="/hotels" />
            </intent-filter>

            <!-- Static App Shortcuts (launcher long-press / Assistant). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Google Maps SDK API key. REQUIRED: the Maps renderer throws a fatal
            exception at MapView init if this meta-data is absent, crashing the
            app the moment the "Map" tab is opened. Value is injected from
            local.properties via the GOOGLE_MAPS_API_KEY manifest placeholder
            (see app/build.gradle.kts). Must be an Android-restricted key with
            the "Maps SDK for Android" API enabled.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <!--
            Firebase Cloud Messaging entry point. FCM only dispatches to a
            FirebaseMessagingService that is declared with the MESSAGING_EVENT
            filter — undeclared, neither onNewToken nor onMessageReceived ever
            fires and push is silently dead.
        -->
        <service
            android:name=".util.PushNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default channel and icon for FCM-composed (notification-payload) messages. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!--
            Receiver for scheduled event-reminder alarms. Must be declared or
            the AlarmManager PendingIntent silently never fires (broken
            reminders). Not exported: only our own exact-match Intent triggers it.
        -->
        <receiver
            android:name=".util.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.desmoines.aipulse.EVENT_REMINDER" />
            </intent-filter>
        </receiver>

        <!--
            Re-schedules event reminders after a reboot. AlarmManager clears
            every pending alarm on restart, so without this the reminder a user
            set days ago silently never arrives.
        -->
        <receiver
            android:name=".util.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
