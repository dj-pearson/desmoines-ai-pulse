<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location: powers "My Location" on the Map tab and nearby search -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".DesMoinesInsiderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DesMoinesInsider">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DesMoinesInsider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Supabase Auth PKCE callback deep link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.desmoines.aipulse"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
            Google Maps SDK API key. REQUIRED: the Maps renderer throws a fatal
            exception at MapView init if this meta-data is absent, crashing the
            app the moment the "Map" tab is opened. Value is injected from
            local.properties via the GOOGLE_MAPS_API_KEY manifest placeholder
            (see app/build.gradle.kts). Must be an Android-restricted key with
            the "Maps SDK for Android" API enabled.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <!--
            Receiver for scheduled event-reminder alarms. Must be declared or
            the AlarmManager PendingIntent silently never fires (broken
            reminders). Not exported: only our own exact-match Intent triggers it.
        -->
        <receiver
            android:name=".util.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.desmoines.aipulse.EVENT_REMINDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
