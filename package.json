{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:infisical": "infisical run --env=dev -- vite",
    "build": "npm run generate-sitemaps && vite build && node scripts/strip-sourcemaps.mjs && npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "build:infisical": "infisical run --env=prod -- npm run build",
    "build:dev": "vite build --mode development",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:strict": "tsc --project tsconfig.strict.json --noEmit",
    "type-check:strict:ratchet": "node scripts/strict-ratchet.mjs",
    "type-check:strict:update": "node scripts/strict-ratchet.mjs --update",
    "type-check:app:ratchet": "node scripts/strict-ratchet.mjs --project app",
    "type-check:app:update": "node scripts/strict-ratchet.mjs --project app --update",
    "preview": "vite preview",
    "migrate": "tsx scripts/run-migration.ts",
    "db:backup": "tsx scripts/supabase-backup.ts",
    "crawl-events": "tsx scripts/event-datetime-crawler.ts",
    "crawl-events:apply": "tsx scripts/event-datetime-crawler.ts --apply",
    "convert-timezones": "tsx scripts/convert-timezones.ts --dry-run",
    "convert-timezones:apply": "tsx scripts/convert-timezones.ts --apply",
    "generate-sitemaps": "tsx scripts/generate-dynamic-sitemaps.ts",
    "generate-sitemaps:infisical": "infisical run --env=dev -- npm run generate-sitemaps",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:links": "playwright test tests/links-and-buttons.spec.ts",
    "test:mobile-responsive": "playwright test tests/mobile-responsive.spec.ts",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "test:performance": "playwright test tests/performance.spec.ts",
    "test:forms": "playwright test tests/forms.spec.ts",
    "test:search": "playwright test tests/search-filters.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen http://localhost:5173",
    "test:export": "node export-test-results.cjs markdown && node export-test-results.cjs csv && node export-test-results.cjs json",
    "test:export:md": "node export-test-results.cjs markdown",
    "test:export:csv": "node export-test-results.cjs csv",
    "test:export:json": "node export-test-results.cjs json",
    "check-imports": "node scripts/check-import-exports.mjs",
    "check-schema": "node scripts/check-schema-usage.mjs",
    "check-schema:all": "node scripts/check-schema-usage.mjs --all",
    "check-schema:update": "node scripts/check-schema-usage.mjs --update",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "validate": "npm run type-check && npm run check-imports && npm run check-schema && npm run check-seo-routes && npm run check-schema-dupes && npm run lint",
    "validate:strict": "npm run type-check:strict && npm run lint",
    "setup:stripe": "node scripts/setup-stripe-products.js",
    "setup:stripe:dry-run": "node scripts/setup-stripe-products.js --dry-run",
    "screenshots:stores": "playwright test --config=playwright.screenshots.config.ts --project=chromium-desktop",
    "screenshots:apple": "playwright test --config=playwright.screenshots.config.ts --project=chromium-desktop --grep=Apple",
    "screenshots:google": "playwright test --config=playwright.screenshots.config.ts --project=chromium-desktop --grep=Google",
    "ralph": "node scripts/ralph/ralph.mjs --tool claude",
    "ralph:amp": "node scripts/ralph/ralph.mjs --tool amp",
    "ralph:resume": "node scripts/ralph/ralph.mjs --tool claude --resume",
    "ralph:android": "node scripts/ralph/ralph.mjs --tool claude --prd prd-android.json --instructions scripts/ralph/CLAUDE-android.md",
    "ralph:android:resume": "node scripts/ralph/ralph.mjs --tool claude --prd prd-android.json --instructions scripts/ralph/CLAUDE-android.md --resume",
    "check-seo-routes": "node scripts/check-seo-route-parity.mjs",
    "check-schema-dupes": "node scripts/check-duplicate-schema.mjs",
    "audit:seo-head": "node scripts/audit-prerendered-seo.mjs"
  },
