{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "types": [],
    "paths": {
      "https://*": ["./supabase/functions/_typecheck/remote.d.ts"],
      "jsr:*": ["./supabase/functions/_typecheck/remote.d.ts"],
      "npm:*": ["./supabase/functions/_typecheck/remote.d.ts"]
    }
  },
  "include": [
    "supabase/functions/_typecheck/*.d.ts",
    "supabase/functions/_shared/**/*.ts"
  ]
}
